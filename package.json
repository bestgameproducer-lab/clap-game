{
  "name": "wedding-task-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:sql": "WEDDING_REQUIRE_SQL_RUNTIME=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/sql-runtime-integration.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:review": "node scripts/run-wedding-review-pack.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@next/swc-wasm-nodejs": "16.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "24.x"
  }
}
